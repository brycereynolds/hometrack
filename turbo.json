{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".svelte-kit/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "inf:dev": {
      "cache": false,
      "persistent": true
    },
    "inf:build": {
      "cache": false
    },
    "inf:start": {
      "cache": false,
      "persistent": true
    }
  }
}
