# Supabase Postgres (used by Drizzle ORM)
DATABASE_URL=postgresql://supabase_admin:password@localhost:5432/postgres

# Supabase API (Kong gateway)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seed user — created automatically by db:seed and linked to the demo team
SEED_USER_EMAIL=dev@hometrack.co
SEED_USER_PASSWORD=hometrack-dev-2026

# Temporal Cloud (optional — workflows will be skipped if API key is not set)
TEMPORAL_ADDRESS=us-west-2.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=quickstart-hometrack.w8bgj
TEMPORAL_API_KEY=
